<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F81A1918"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="64sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="집중 모드 작동 중"
        android:textColor="#FAF7F2"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="현재 허용된 앱만 사용하실 수 있습니다.\n목표 달성을 위해 조금만 더 몰입해 보세요!"
        android:textAlignment="center"
        android:textColor="#A09D98"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnGoApp"
            android:layout_width="240dp"
            android:layout_height="52dp"
            android:backgroundTint="#FF385C"
            android:text="Study Focus 앱으로 돌아가기"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGoHome"
            android:layout_width="240dp"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#2E2A27"
            android:text="홈 화면으로 이동"
            android:textColor="#ECE6E0"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
